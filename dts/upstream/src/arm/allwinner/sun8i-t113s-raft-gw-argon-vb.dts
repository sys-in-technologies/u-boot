#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pwm/pwm.h>

/dts-v1/;

#include "sun8i-t113s.dtsi"

/ {
	model = "Raft Gataway ARGON VB";
	compatible = "allwinner,sun8i-t113s";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	/* board wide 5V supply directly from DC input */
	reg_vcc5v: regulator-5v {
		compatible = "regulator-fixed";
		regulator-name = "vcc-5v";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
	};

	/* AMS1117-3.3 regulator on the board */
	reg_3v3: regulator-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&reg_vcc5v>;
	};

	/* EA3036C DC/DC regulator on the board, also supplying VDD-SYS */
	reg_vcc_core: regulator-core {
		compatible = "regulator-fixed";
		regulator-name = "vcc-core";
		regulator-min-microvolt = <900000>;
		regulator-max-microvolt = <900000>;
		vin-supply = <&reg_vcc5v>;
	};

	/* XC6206 LDO on the board */
	reg_avdd2v8: regulator-avdd {
		compatible = "regulator-fixed";
		regulator-name = "avdd2v8";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		vin-supply = <&reg_3v3>;
	};

	/* XC6206 LDO on the board */
	reg_1v8: regulator-vcc-dsi {
		compatible = "regulator-fixed";
		regulator-name = "vcc-dsi";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&reg_3v3>;
	};

	watchdog {
		compatible = "allwinner,sun20i-d1-wdt";
		reg = <0x020500A0 0x20>;
	};

	raft-user-gpios {
		compatible = "raft-user-gpios";
		mesh-pwr-gpios {
			pin = "PC6";
			function = "output";
			value = <1>;
		};

		wifi-pwr-gpios {
			pin = "PC7";
			function = "output";
			value = <1>;
		};

		4g-pwr-gpios {
			pin = "PC3";
			function = "output";
			value = <1>;
		};

		4g-rst-gpios {
			pin = "PC2";
			function = "reset";
			value = <1>;
			keep_ms = <100>;
		};

		tp-pwr-gpios {
			pin = "PD18";
			function = "output";
			value = <1>;
		};

                ephy-rst-gpios {
			pin = "PG9";
			function = "reset";
			value = <0>;
			keep_ms = <100>;
		};

		backlight_en_gpios {
			pin = "PD17";
			function = "output";
			value = <1>;
		};

		gps-rst-gpios {
			pin = "PB3";
			function = "reset";
			value = <0>;
			keep_ms = <10>;
		};

		gps-pps-gpios {
			pin = "PB2";
			function = "input";
		};

		nd-full-gpios {
			pin = "PD16";
			function = "input";
		};

		nd-empty-gpios {
			pin = "PD15";
			function = "input";
		};

		nd-mode-gpios {
			pin = "PD14";
			function = "input";
		};
	};

	pwm: pwm@2000c00 {
		compatible = "allwinner,sun8i-h3-pwm";
		reg = <0x02000c00 0x400>;
		clocks = <&dcxo>;
		#pwm-cells = <3>;
		status = "okay";
	};

	backlight: backlight {
		   compatible = "pwm-backlight";
		   pwms = <&pwm 0 100000 PWM_POLARITY_INVERTED>;
		   power-supply = <&reg_vcc5v>;
		   /* gpio not connect to real backligth */
		   brightness-levels = <0 30 40 50 60 70 80 90 100>;
		   default-brightness-level = <8>;
	};
};

&dcxo {
	clock-frequency = <24000000>;
};

&cpu0 {
	cpu-supply = <&reg_vcc_core>;
};

&cpu1 {
	cpu-supply = <&reg_vcc_core>;
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pe_pins>;
	status = "okay";
};

&mmc0 {
	pinctrl-names = "default";
	pinctrl-0 = <&mmc0_pins>;
	vmmc-supply = <&reg_3v3>;
	disable-wp;
	bus-width = <4>;
	status = "okay";
};

&pio {
	vcc-pb-supply = <&reg_3v3>;
	vcc-pd-supply = <&reg_3v3>;
	vcc-pe-supply = <&reg_avdd2v8>;
	vcc-pf-supply = <&reg_3v3>;
	vcc-pg-supply = <&reg_3v3>;

	rmii_pg_pins: rmii-pg-pins {
		pins = "PG0", "PG1", "PG2", "PG3", "PG4",
		"PG5", "PG6", "PG7", "PG8", "PG10", "PG11",
		"PG12", "PG13", "PG14", "PG15";
		function = "emac";
	};

	uart0_pe_pins: uart0-pe-pins {
		pins = "PE2", "PE3";
		function = "uart0";
	};
};

&emac {
	compatible = "allwinner,sun50i-h6-emac";
	pinctrl-names = "default";
	pinctrl-0 = <&rmii_pg_pins>;
	clocks = <&ccu CLK_BUS_EMAC>, <&ccu CLK_EMAC_25M>;
	clock-names = "stmmaceth", "ext25m_clk";
	phy-mode = "rmii";
	phy-handle = <&phy0>;
	phy-supply = <&reg_3v3>;
	status = "okay";
};

&mdio {
	phy0: ethernet-phy@0 {
		reg = <0>;
		motorcomm,auto-sleep-disabled;
		motorcomm,keep-pll-enabled;
	};
};

&ehci1 {
	status = "okay";
};

&ohci1 {
	status = "okay";
};
/* The USB-C socket has its CC pins pulled to GND, so is hardwired as a UFP. */
&usb_otg {
	dr_mode = "peripheral";
	status = "okay";
};

&usbphy {
	usb1_vbus-supply = <&reg_vcc5v>;
	status = "okay";
};


&dsi {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	vcc-dsi-supply = <&reg_1v8>;

#if 1
	panel@0 {
		compatible = "huadichuangxian,hd50004c30", "ilitek,ili9881c";
		reg = <0>;
		power-supply = <&reg_avdd2v8>;
		reset-gpios = <&pio 4 1 GPIO_ACTIVE_LOW>;
		backlight = <&backlight>;
	};
#endif

#if 0
	panel@0 {
		compatible = "elitek,ek79007";
		reg = <0>;
		power-supply = <&reg_avdd2v8>;
		reset-gpios = <&pio 4 1 GPIO_ACTIVE_LOW>;
		backlight = <&backlight>;
	};
#endif

	port {
		dsi_in_tcon_lcd0: endpoint {
			remote-endpoint = <&tcon_lcd0_out_dsi>;
		};
	};
};

&de {
	allwinner,pipelines = <&mixer0>;
	status = "okay";
};

&mixer0 {
	status = "okay";
	ports {
		mixer0_out: port@1 {
			mixer0_out_tcon_top_mixer0: endpoint {
				remote-endpoint = <&tcon_top_mixer0_in_mixer0>;
			};
		};
	};
};

/delete-node/ &mixer1;

&tcon_top {
	status = "okay";
	ports {
		tcon_top_mixer0_in: port@0 {
			tcon_top_mixer0_in_mixer0: endpoint {
				remote-endpoint = <&mixer0_out_tcon_top_mixer0>;
			};
		};

		tcon_top_mixer0_out: port@1 {
			tcon_top_mixer0_out_tcon_lcd0: endpoint@0 {
				remote-endpoint = <&tcon_lcd0_in_tcon_top_mixer0>;
			};

			/delete-node/ endpoint@2;
		};
		/delete-node/ port@2;
		/delete-node/ port@3;
		/delete-node/ port@4;
		/delete-node/ port@5;
	};
};

&tcon_lcd0 {
	status = "okay";
	ports {
		tcon_lcd0_in: port@0 {
			tcon_lcd0_in_tcon_top_mixer0: endpoint@0 {
				remote-endpoint = <&tcon_top_mixer0_out_tcon_lcd0>;
			};

			/delete-node/ endpoint@1;
		};

		tcon_lcd0_out: port@1 {
			tcon_lcd0_out_dsi: endpoint@1 {
				remote-endpoint = <&dsi_in_tcon_lcd0>;
			};
		};
	};
};

/delete-node/ &tcon_tv0;
